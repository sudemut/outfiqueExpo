{
  "expo": {
    "name": "OutfiqueExpo",
    "slug": "OutfiqueExpo",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "outfiqueexpo",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "ios": {
      
      "supportsTablet": true,
      "infoPlist" : {
       "NSCameraUsageDescription": "We need access to your camera to let you take outfit photos.",
       "NSPhotoLibraryUsageDescription": "We need access to your photo library to select outfit images."
        }
      
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/images/adaptive-icon.png",
        "backgroundColor": "#ffffff"
      },
      "edgeToEdgeEnabled": true
    },
    "web": {
      "bundler": "metro",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 200,
          "resizeMode": "contain",
          "backgroundColor": "#ffffff"
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    }
  }
}
